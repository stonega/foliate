<?xml version="1.0" encoding="UTF-8"?>
<interface>
<template class="FoliateAIChatPanelFixed" parent="GtkBox">
  <property name="orientation">vertical</property>
  <property name="hexpand">False</property>
  
  <!-- Header -->
  <child>
    <object class="GtkWindowHandle">
      <child>
        <object class="GtkBox" id="header-box">
          <property name="orientation">horizontal</property>
          <property name="margin-start">4</property>
          <property name="margin-end">4</property>
          <property name="margin-top">4</property>
          <property name="margin-bottom">4</property>
          <property name="spacing">4</property>
          <child>
            <object class="GtkLabel">
              <property name="label" translatable="yes">AI Chat</property>
              <property name="hexpand">True</property>
              <property name="xalign">0</property>
              <style><class name="title"/></style>
            </object>
          </child>
          <child>
            <object class="GtkButton" id="new-chat-button">
              <property name="icon-name">list-add-symbolic</property>
              <property name="tooltip-text" translatable="yes">New Chat</property>
              <style><class name="flat"/><class name="circular"/></style>
            </object>
          </child>
          <child>
            <object class="GtkButton" id="history-button">
              <property name="icon-name">document-open-recent-symbolic</property>
              <property name="tooltip-text" translatable="yes">Chat History</property>
              <style><class name="flat"/><class name="circular"/></style>
            </object>
          </child>
          <child>
            <object class="GtkWindowControls">
              <property name="side">end</property>
            </object>
          </child>
        </object>
      </child>
    </object>
  </child>
  
  <!-- Model indicator -->
  <child>
    <object class="GtkBox">
      <property name="orientation">horizontal</property>
      <property name="margin-start">12</property>
      <property name="margin-end">12</property>
      <property name="margin-top">6</property>
      <property name="margin-bottom">6</property>
      <property name="spacing">6</property>
      <child>
        <object class="GtkImage">
          <property name="icon-name">applications-science-symbolic</property>
          <style><class name="dim-label"/></style>
        </object>
      </child>
      <child>
        <object class="GtkLabel" id="model-label">
          <property name="label" translatable="yes">No model configured</property>
          <property name="ellipsize">end</property>
          <property name="hexpand">True</property>
          <property name="xalign">0</property>
          <style><class name="caption"/><class name="dim-label"/></style>
        </object>
      </child>
    </object>
  </child>
  
  <!-- Chat messages area -->
  <child>
    <object class="GtkScrolledWindow" id="scroll-window">
      <property name="vexpand">True</property>
      <property name="hexpand">False</property>
      <property name="hscrollbar-policy">never</property>
      <property name="propagate-natural-width">False</property>
      <child>
        <object class="GtkBox" id="chat-list">
          <property name="orientation">vertical</property>
          <property name="spacing">0</property>
          <property name="hexpand">False</property>
        </object>
      </child>
    </object>
  </child>
  
  <!-- Loading indicator and status -->
  <child>
    <object class="GtkBox">
      <property name="orientation">horizontal</property>
      <property name="margin-start">12</property>
      <property name="margin-end">12</property>
      <property name="margin-top">6</property>
      <property name="margin-bottom">6</property>
      <property name="spacing">8</property>
      <property name="halign">center</property>
      <child>
        <object class="GtkSpinner" id="loading-spinner">
          <property name="visible">False</property>
        </object>
      </child>
      <child>
        <object class="GtkLabel" id="status-label">
          <property name="visible">False</property>
          <property name="label" translatable="yes">AI is thinking…</property>
          <style><class name="caption"/><class name="dim-label"/></style>
        </object>
      </child>
    </object>
  </child>
  
  <!-- Input area -->
  <child>
    <object class="GtkBox">
      <property name="orientation">vertical</property>
      <property name="margin-start">8</property>
      <property name="margin-end">8</property>
      <property name="margin-top">6</property>
      <property name="margin-bottom">8</property>
      <property name="spacing">6</property>
      <property name="hexpand">False</property>
      <style><class name="chat-input-area"/></style>
      
      <!-- Context indicator bar -->
      <child>
        <object class="GtkRevealer" id="context-revealer">
          <property name="reveal-child">False</property>
          <property name="transition-type">slide-down</property>
          <child>
            <object class="GtkBox" id="context-bar">
              <property name="orientation">horizontal</property>
              <property name="spacing">6</property>
              <property name="margin-start">4</property>
              <property name="margin-end">4</property>
              <property name="margin-top">2</property>
              <property name="margin-bottom">2</property>
              <style><class name="context-indicator"/></style>
              <child>
                <object class="GtkImage">
                  <property name="icon-name">emblem-documents-symbolic</property>
                  <style><class name="dim-label"/></style>
                </object>
              </child>
              <child>
                <object class="GtkLabel" id="context-label">
                  <property name="label" translatable="yes">Context attached</property>
                  <property name="hexpand">True</property>
                  <property name="xalign">0</property>
                  <property name="ellipsize">end</property>
                  <style><class name="caption"/><class name="dim-label"/></style>
                </object>
              </child>
              <child>
                <object class="GtkButton" id="clear-context-button">
                  <property name="icon-name">window-close-symbolic</property>
                  <property name="valign">center</property>
                  <property name="tooltip-text" translatable="yes">Clear context</property>
                  <style><class name="flat"/><class name="circular"/><class name="dim-label"/></style>
                </object>
              </child>
            </object>
          </child>
        </object>
      </child>
      
      <!-- Input row with text and send button -->
      <child>
        <object class="GtkBox">
          <property name="orientation">horizontal</property>
          <property name="spacing">6</property>
          <property name="hexpand">False</property>
          <child>
            <object class="GtkFrame" id="input-frame">
              <property name="hexpand">True</property>
              <style><class name="chat-input-frame"/></style>
              <child>
                <object class="GtkBox">
                  <property name="orientation">vertical</property>
                  <child>
                    <object class="GtkScrolledWindow">
                      <property name="hexpand">True</property>
                      <property name="propagate-natural-height">True</property>
                      <property name="propagate-natural-width">False</property>
                      <property name="max-content-height">120</property>
                      <property name="min-content-height">36</property>
                      <property name="vscrollbar-policy">automatic</property>
                      <property name="hscrollbar-policy">never</property>
                      <child>
                        <object class="GtkTextView" id="message-view">
                          <property name="hexpand">True</property>
                          <property name="wrap-mode">word-char</property>
                          <property name="accepts-tab">False</property>
                          <property name="left-margin">8</property>
                          <property name="right-margin">8</property>
                          <property name="top-margin">8</property>
                          <property name="bottom-margin">8</property>
                          <style><class name="chat-input-text"/></style>
                        </object>
                      </child>
                    </object>
                  </child>
                  <!-- Bottom toolbar with context buttons -->
                  <child>
                    <object class="GtkBox" id="input-toolbar">
                      <property name="orientation">horizontal</property>
                      <property name="spacing">2</property>
                      <property name="margin-start">4</property>
                      <property name="margin-end">4</property>
                      <property name="margin-bottom">4</property>
                      <child>
                        <object class="GtkButton" id="include-chapter-button">
                          <property name="icon-name">view-list-symbolic</property>
                          <property name="tooltip-text" translatable="yes">Include current chapter as context</property>
                          <property name="valign">center</property>
                          <style><class name="flat"/><class name="circular"/><class name="context-button"/></style>
                        </object>
                      </child>
                      <child>
                        <object class="GtkButton" id="include-page-button">
                          <property name="icon-name">view-paged-symbolic</property>
                          <property name="tooltip-text" translatable="yes">Include current page as context</property>
                          <property name="valign">center</property>
                          <style><class name="flat"/><class name="circular"/><class name="context-button"/></style>
                        </object>
                      </child>
                      <child>
                        <object class="GtkBox">
                          <property name="hexpand">True</property>
                        </object>
                      </child>
                      <child>
                        <object class="GtkLabel" id="send-hint-label">
                          <property name="label" translatable="yes">Enter to send</property>
                          <property name="valign">center</property>
                          <style><class name="caption"/><class name="dim-label"/></style>
                        </object>
                      </child>
                      <child>
                        <object class="GtkButton" id="send-button">
                          <property name="valign">center</property>
                          <property name="icon-name">go-up-symbolic</property>
                          <property name="tooltip-text" translatable="yes">Send Message (Enter)</property>
                          <style><class name="suggested-action"/></style>
                        </object>
                      </child>
                    </object>
                  </child>
                </object>
              </child>
            </object>
          </child>

        </object>
      </child>
    </object>
  </child>
</template>
</interface>
