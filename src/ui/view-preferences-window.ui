<?xml version="1.0" encoding="UTF-8"?><interface>
<template class="FoliateViewPreferencesWindow" parent="AdwPreferencesDialog">
  <child>
    <object class="AdwPreferencesPage">
      <property name="title" translatable="yes">Font</property>
      <property name="icon-name">font-select-symbolic</property>
      <child>
        <object class="AdwPreferencesGroup">
          <property name="title" translatable="yes">Font Size</property>
          <child>
            <object class="AdwSpinRow" id="default-font-size">
              <property name="title" translatable="yes">Default Font Size</property>
              <property name="adjustment">
                <object class="GtkAdjustment">
                  <property name="lower">1</property>
                  <property name="upper">72</property>
                  <property name="step-increment">1</property>
                  <property name="page-increment">1</property>
                </object>
              </property>
            </object>
          </child>
          <child>
            <object class="AdwSpinRow" id="minimum-font-size">
              <property name="title" translatable="yes">Minimum Font Size</property>
              <property name="adjustment">
                <object class="GtkAdjustment">
                  <property name="lower">1</property>
                  <property name="upper">72</property>
                  <property name="step-increment">1</property>
                  <property name="page-increment">1</property>
                </object>
              </property>
            </object>
          </child>
        </object>
      </child>
      <child>
        <object class="AdwPreferencesGroup">
          <property name="title" translatable="yes">Font Family</property>
          <child>
            <object class="AdwComboRow" id="default-font">
              <property name="title" translatable="yes">Default Font</property>
              <property name="model">
                <object class="GtkStringList">
                  <items>
                    <item translatable="yes">Serif</item>
                    <item translatable="yes">Sans-serif</item>
                  </items>
                </object>
              </property>
            </object>
          </child>
          <child>
            <object class="AdwActionRow">
              <property name="title" translatable="yes">Override Publisher Font</property>
              <property name="activatable-widget">override-font</property>
              <child>
                <object class="GtkSwitch" id="override-font">
                  <property name="valign">center</property>
                </object>
              </child>
            </object>
          </child>
        </object>
      </child>
      <child>
        <object class="AdwPreferencesGroup">
          <child>
            <object class="AdwActionRow">
              <property name="title" translatable="yes">Serif Font</property>
              <property name="activatable-widget">serif-font</property>
              <child>
                <object class="GtkFontButton" id="serif-font">
                  <property name="level">family</property>
                  <property name="use-font">true</property>
                  <property name="valign">center</property>
                </object>
              </child>
            </object>
          </child>
          <child>
            <object class="AdwActionRow">
              <property name="title" translatable="yes">Sans-Serif Font</property>
              <property name="activatable-widget">sans-serif-font</property>
              <child>
                <object class="GtkFontButton" id="sans-serif-font">
                  <property name="level">family</property>
                  <property name="use-font">true</property>
                  <property name="valign">center</property>
                </object>
              </child>
            </object>
          </child>
          <child>
            <object class="AdwActionRow">
              <property name="title" translatable="yes">Monospace Font</property>
              <property name="activatable-widget">monospace-font</property>
              <child>
                <object class="GtkFontButton" id="monospace-font">
                  <property name="level">family</property>
                  <property name="use-font">true</property>
                  <property name="valign">center</property>
                </object>
              </child>
            </object>
          </child>
        </object>
      </child>
    </object>
  </child>
  <child>
    <object class="AdwPreferencesPage">
      <property name="title" translatable="yes">Layout</property>
      <property name="icon-name">document-page-setup-symbolic</property>
      <child>
        <object class="AdwPreferencesGroup">
          <property name="title" translatable="yes">Paragraph</property>
          <child>
            <object class="AdwSpinRow" id="line-height">
              <property name="title" translatable="yes">Line Height</property>
              <property name="digits">2</property>
              <property name="adjustment">
                <object class="GtkAdjustment">
                  <property name="lower">1</property>
                  <property name="upper">3</property>
                  <property name="step-increment">0.05</property>
                  <property name="page-increment">0.1</property>
                </object>
              </property>
            </object>
          </child>
          <child>
            <object class="AdwActionRow">
              <property name="title" translatable="yes">Full Justification</property>
              <property name="activatable-widget">justify</property>
              <child>
                <object class="GtkSwitch" id="justify">
                  <property name="valign">center</property>
                </object>
              </child>
            </object>
          </child>
          <child>
            <object class="AdwActionRow">
              <property name="title" translatable="yes">Hyphenation</property>
              <property name="activatable-widget">hyphenate</property>
              <child>
                <object class="GtkSwitch" id="hyphenate">
                  <property name="valign">center</property>
                </object>
              </child>
            </object>
          </child>"
        </object>
      </child>
      <child>
        <object class="AdwPreferencesGroup">
          <property name="title" translatable="yes">Page</property>
          <child>
            <object class="AdwSpinRow" id="gap">
              <property name="title" translatable="yes">Margins</property>
              <property name="digits">2</property>
              <property name="adjustment">
                <object class="GtkAdjustment">
                  <property name="lower">0</property>
                  <property name="upper">0.5</property>
                  <property name="step-increment">0.01</property>
                  <property name="page-increment">0.01</property>
                </object>
              </property>
            </object>
          </child>
          <child>
            <object class="AdwSpinRow" id="max-column-count">
              <property name="title" translatable="yes">Maximum Number of Columns</property>
              <property name="adjustment">
                <object class="GtkAdjustment">
                  <property name="lower">1</property>
                  <property name="upper">10</property>
                  <property name="step-increment">1</property>
                  <property name="page-increment">1</property>
                </object>
              </property>
            </object>
          </child>
          <child>
            <object class="AdwSpinRow" id="max-inline-size">
              <property name="title" translatable="yes">Maximum Inline Size</property>
              <property name="subtitle" translatable="yes">Maximum column width (horizontal writing) or height (vertical writing)</property>
              <property name="adjustment">
                <object class="GtkAdjustment">
                  <property name="lower">100</property>
                  <property name="upper">5000</property>
                  <property name="step-increment">60</property>
                  <property name="page-increment">60</property>
                </object>
              </property>
            </object>
          </child>
          <child>
            <object class="AdwSpinRow" id="max-block-size">
              <property name="title" translatable="yes">Maximum Block Size</property>
              <property name="subtitle" translatable="yes">Maximum height (horizontal writing) or width (vertical writing)</property>
              <property name="adjustment">
                <object class="GtkAdjustment">
                  <property name="lower">100</property>
                  <property name="upper">5000</property>
                  <property name="step-increment">60</property>
                  <property name="page-increment">60</property>
                </object>
              </property>
            </object>
          </child>
        </object>
      </child>
    </object>
  </child>
  <child>
    <object class="AdwPreferencesPage">
      <property name="title" translatable="yes">Color</property>
      <property name="icon-name">applications-graphics-symbolic</property>
      <child>
        <object class="AdwPreferencesGroup">
          <child>
            <object class="GtkFlowBox" id="theme-flow-box">
              <property name="selection-mode">none</property>
              <property name="homogeneous">True</property>
              <property name="row-spacing">12</property>
              <property name="column-spacing">12</property>
              <style><class name="theme-container"/></style>
            </object>
          </child>
        </object>
      </child>
    </object>
  </child>
  <child>
    <object class="AdwPreferencesPage">
      <property name="title" translatable="yes">Behavior</property>
      <property name="icon-name">input-mouse-symbolic</property>
      <child>
        <object class="AdwPreferencesGroup">
          <child>
            <object class="AdwActionRow">
              <property name="title" translatable="yes">Reduce Animation</property>
              <property name="activatable-widget">reduce-animation</property>
              <child>
                <object class="GtkSwitch" id="reduce-animation">
                  <property name="valign">center</property>
                </object>
              </child>
            </object>
          </child>
        </object>
      </child>
    </object>
  </child>
  <child>
    <object class="AdwPreferencesPage" id="ai-page">
      <property name="title" translatable="yes">AI</property>
      <property name="icon-name">applications-science-symbolic</property>
      
      <!-- Models List -->
      <child>
        <object class="AdwPreferencesGroup">
          <property name="title" translatable="yes">Configured Models</property>
          <property name="description" translatable="yes">Manage your AI model configurations. Models use OpenAI-compatible API endpoints.</property>
          
          <child>
            <object class="GtkListBox" id="models-list">
              <property name="selection-mode">none</property>
              <style><class name="boxed-list"/></style>
              
              <!-- Empty state -->
              <child>
                <object class="AdwActionRow" id="empty-state">
                  <property name="title" translatable="yes">No Models Configured</property>
                  <property name="subtitle" translatable="yes">Add an AI model to start using the chat assistant</property>
                  <child type="prefix">
                    <object class="GtkImage">
                      <property name="icon-name">list-add-symbolic</property>
                      <style><class name="dim-label"/></style>
                    </object>
                  </child>
                </object>
              </child>
            </object>
          </child>
          
          <child>
            <object class="GtkButton" id="add-model-button">
              <property name="margin-top">12</property>
              <property name="halign">start</property>
              <child>
                <object class="GtkBox">
                  <property name="spacing">6</property>
                  <child>
                    <object class="GtkImage">
                      <property name="icon-name">list-add-symbolic</property>
                    </object>
                  </child>
                  <child>
                    <object class="GtkLabel">
                      <property name="label" translatable="yes">Add Model</property>
                    </object>
                  </child>
                </object>
              </child>
              <style><class name="suggested-action"/><class name="pill"/></style>
            </object>
          </child>
        </object>
      </child>

      <!-- Chat Settings -->
      <child>
        <object class="AdwPreferencesGroup">
          <property name="title" translatable="yes">Chat</property>

          <child>
            <object class="AdwComboRow" id="explain-language-row">
              <property name="title" translatable="yes">Explain Language</property>
              <property name="subtitle" translatable="yes">Language used for explanations and translations</property>
            </object>
          </child>

          <child>
            <object class="AdwActionRow">
              <property name="title" translatable="yes">Enter to Send</property>
              <property name="subtitle" translatable="yes">Turn off to send with Ctrl+Enter instead</property>
              <property name="activatable-widget">send-on-enter-switch</property>
              <child type="suffix">
                <object class="GtkSwitch" id="send-on-enter-switch">
                  <property name="valign">center</property>
                </object>
              </child>
            </object>
          </child>
        </object>
      </child>
      
      <!-- Context Settings -->
      <child>
        <object class="AdwPreferencesGroup">
          <property name="title" translatable="yes">Document Context</property>
          <property name="description" translatable="yes">Configure how the AI uses document content for context-aware responses.</property>
          
          <child>
            <object class="AdwActionRow">
              <property name="title" translatable="yes">Include Document Context</property>
              <property name="subtitle" translatable="yes">Send current page content to AI for better responses about the book</property>
              <property name="activatable-widget">include-context-switch</property>
              <child type="suffix">
                <object class="GtkSwitch" id="include-context-switch">
                  <property name="valign">center</property>
                </object>
              </child>
            </object>
          </child>
          
          <child>
            <object class="AdwSpinRow" id="context-length-spin">
              <property name="title" translatable="yes">Context Length</property>
              <property name="subtitle" translatable="yes">Maximum characters to include as context</property>
              <property name="adjustment">
                <object class="GtkAdjustment">
                  <property name="lower">500</property>
                  <property name="upper">10000</property>
                  <property name="step-increment">500</property>
                  <property name="page-increment">1000</property>
                  <property name="value">2000</property>
                </object>
              </property>
            </object>
          </child>
        </object>
      </child>
      
      <!-- Usage Tips -->
      <child>
        <object class="AdwPreferencesGroup">
          <property name="title" translatable="yes">Tips</property>
          
          <child>
            <object class="GtkLabel">
              <property name="wrap">True</property>
              <property name="xalign">0</property>
              <property name="margin-top">6</property>
              <property name="margin-bottom">6</property>
              <property name="label" translatable="yes">• Use OpenAI-compatible endpoints (OpenAI, Anthropic via proxy, local models with Ollama, etc.)
• API keys are stored locally and never shared
• The AI can reference the current page when answering questions
• Toggle the AI panel with the sidebar button in the reading view</property>
              <style><class name="caption"/><class name="dim-label"/></style>
            </object>
          </child>
        </object>
      </child>
    </object>
  </child>
</template>
</interface>
